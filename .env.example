# mock: 브라우저 내 PoC 데이터 / n8n: 실제 n8n Webhook 연동
VITE_DATA_MODE=mock

# 실제 연동 시 인증된 HTTPS n8n/Gateway 기본 주소만 설정한다.
# 브라우저 번들에 API Key, n8n Credential, Local LLM 토큰을 넣지 않는다.
# vLLM(예: :8000 /v1/*), llama.cpp, Ollama(예: :11434) 추론 endpoint를 직접 지정하지 않는다.
# HyperCLOVA X(vLLM) -> VRAM release/model switch -> KT Mi:dm(llama.cpp)는 n8n/FastAPI 서버측 F-04 단일 Queue에서만 제어한다.
VITE_N8N_BASE_URL=https://example.your-domain.com
